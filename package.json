{
    "name": "laramod-vite-plugin",
    "version": "0.0.0",
    "description": "Vite plugin for Laravel applications built with protibimbok/laramod modules.",
    "type": "module",
    "keywords": [
        "laramod",
        "laravel",
        "modules",
        "vite",
        "vite-plugin"
    ],
    "license": "MIT",
    "author": "Saad <sakib.saad.khan@gmail.com>",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
        "prepublishOnly": "npm run test"
    },
    "devDependencies": {
        "@types/node": "^22.18.1",
        "laravel-vite-plugin": "^3.2.0",
        "typescript": "^5.9.2",
        "vite": "^8.0.0"
    },
    "peerDependencies": {
        "laravel-vite-plugin": "^2.0.0 || ^3.0.0",
        "vite": "^7.0.0 || ^8.0.0"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1"
    }
}
